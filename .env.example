# For published images; local development uses compose.dev.yaml and texec:dev.
TEXEC_VERSION=v1.2.0
TEXEC_IMAGE=impishmd/texec
TEXEC_BIND_ADDRESS=127.0.0.1
TEXEC_ADMIN=admin
TEXEC_ADMIN_NAME=Administrator
TEXEC_ADMIN_EMAIL=admin@localhost
TEXEC_ADMIN_PASSWORD=
# Generate once: openssl rand -base64 32. Keep the key with your backups.
TEXEC_ACCESS_KEY_ENCRYPTION=
